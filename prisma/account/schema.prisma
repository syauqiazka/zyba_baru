generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x"]
  output        = "../../src/generated/account-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_ACCOUNT")
  directUrl = env("DIRECT_URL_ACCOUNT")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  username     String? @unique
  passwordHash String
  name         String
  avatarUrl    String?
  phone        String?
  location     String?
  bio          String?

  companionPersona CompanionPersona @default(ZIBI)
  role             UserRole         @default(USER)

  isSuspended      Boolean          @default(false)
  suspendedUntil   DateTime?
  isBanned         Boolean          @default(false)
  banReason        String?
  warningCount     Int              @default(0)

  onboardingCompleted Boolean @default(false)

  termsAcceptedAt               DateTime?
  termsVersion                  String?
  communityGuidelinesAcceptedAt DateTime?
  communityGuidelinesVersion    String?

  zybaScore   Int?
  stressLevel Int?
  streak      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment       Assessment?
  moodEntries      MoodEntry[]
  dailyAssessments DailyAssessment[]
  journalEntries   JournalEntry[]
  activities       ActivityLog[]
  notificationPref NotificationPref?
  moderationLogs   ModerationLog[]  @relation("ModeratedUser")
  adminActions     ModerationLog[]  @relation("ModeratingAdmin")

  streakDays         Int?      @default(0)
  lastStreakDate     DateTime?
  lastAvatarChangeAt DateTime?

  @@map("users")
}

// FASE 4: ganti CommunicationStyle → CompanionPersona
enum CompanionPersona {
  ZIBI
  KINA
  OLLIE
  RUBI
  BRUNO
}

model NotificationPref {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companionNotif Boolean @default(true)
  wellnessNotif  Boolean @default(true)
  communityNotif Boolean @default(false)

  @@map("notification_prefs")
}

model Assessment {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal                 String?
  gender               String?
  age                  Int?
  weightKg             Float?
  initialMood          MoodLevel?
  soughtHelpBefore     Boolean?
  physicalSymptoms     String[]
  sleepQualityRating   Int?
  stressLevel          Int?
  medications          String?
  mentalHealthSymptoms String[]
  expressionText       String?
  flaggedForRisk       Boolean    @default(false)

  createdAt DateTime @default(now())

  @@map("assessments")
}

enum MoodLevel {
  DEPRESSED
  SAD
  NEUTRAL
  HAPPY
  OVERJOYED
}

model MoodEntry {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood        MoodLevel
  stressLevel Int?
  note        String?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("mood_entries")
}

model DailyAssessment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date            String
  mood            MoodLevel
  stressLevel     Int?
  sleepRating     Int?
  energyTags      String[]
  reflection      String?
  answers         Json?
  flaggedForRisk  Boolean   @default(false)
  calculatedScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, createdAt])
  @@index([userId, date, createdAt])
  @@map("daily_assessments")
}

model JournalEntry {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  mood      MoodLevel?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
  @@map("journal_entries")
}

enum ActivityType {
  WALKING
  RUNNING
  WORKOUT
  BREATHING
  SLEEP
}

model ActivityLog {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          ActivityType
  durationMin   Int?
  distanceMeter Int?
  targetMin     Int?
  completed     Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
  @@map("activity_logs")
}

enum ResourceType {
  ARTICLE
  COURSE
  AUDIO
}

model Resource {
  id          String       @id @default(cuid())
  type        ResourceType
  title       String
  author      String?
  coverUrl    String?
  audioUrl    String?
  durationMin Int?
  body        String?
  createdAt   DateTime     @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@map("resources")
}

enum UserRole {
  USER
  ADMIN
}

enum ModerationActionType {
  WARN
  HIDE_POST
  HIDE_COMMENT
  DELETE_POST
  DELETE_COMMENT
  SUSPEND
  BAN
  LIFT_RESTRICTION
  DISMISS_REPORT
}

model ModerationLog {
  id           String               @id @default(cuid())
  adminId      String
  admin        User                 @relation("ModeratingAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User                 @relation("ModeratedUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  action       ModerationActionType
  reason       String
  durationDays Int?
  reportId     String?
  metadata     Json?
  createdAt    DateTime             @default(now())

  @@index([targetUserId, createdAt])
  @@index([adminId, createdAt])
  @@map("moderation_logs")
}

// ----------------------------------------------------
// AUTOMATED HEALTH & WELLNESS ARTICLE SYSTEM (FASE P8)
// ----------------------------------------------------

enum ArticleCategory {
  MENTAL_HEALTH
  SELF_CARE
  MINDFULNESS
  PHYSICAL_WELLNESS
  SLEEP_AND_REST
  EMOTIONAL_WELLNESS
  RELATIONSHIPS
  PERSONAL_DEVELOPMENT
}

enum ArticleStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

model ArticleSource {
  id              String           @id @default(cuid())
  name            String
  url             String           @unique
  websiteUrl      String?
  defaultCategory ArticleCategory?
  isActive        Boolean          @default(true)
  lastSyncAt      DateTime?
  lastStatus      String?          // "SUCCESS", "ERROR", "TIMEOUT"
  lastError       String?
  totalFetched    Int              @default(0)
  totalApproved   Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  articles        Article[]
  syncLogs        ArticleSyncLog[]

  @@map("article_sources")
}

model Article {
  id              String          @id @default(cuid())
  sourceId        String?
  source          ArticleSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceName      String          // mis. "WHO", "Kemenkes RI", "APA"
  sourceUrl       String          // URL artikel asli
  canonicalUrl    String          @unique // URL kanonikal untuk deteksi duplikasi
  externalId      String?         // GUID dari RSS
  
  title           String
  slug            String          @unique
  excerpt         String          // Ringkasan original hasil kurasi/ekstraksi
  content         String?         // Cuplikan konten / paragraf inti (bukan salinan ilegal full text)
  category        ArticleCategory @default(MENTAL_HEALTH)
  thumbnail       String?         // URL thumbnail resmi jika diizinkan
  publishedAt     DateTime        @default(now())
  fetchedAt       DateTime        @default(now())
  
  status          ArticleStatus   @default(PENDING)
  relevanceScore  Int             @default(0) // 0 - 100
  relevanceReason String?
  language        String          @default("id") // "id" | "en"
  readingTime     Int             @default(3) // estimasi menit baca
  
  reviewedBy      String?         // Admin user ID jika sudah direview
  reviewedAt      DateTime?
  reviewNotes     String?
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([category, status])
  @@index([status, publishedAt])
  @@index([canonicalUrl])
  @@index([slug])
  @@map("articles")
}

model ArticleSyncLog {
  id                String          @id @default(cuid())
  sourceId          String?
  source            ArticleSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceName        String?
  status            String          // "SUCCESS" | "PARTIAL" | "FAILED"
  articlesFound     Int             @default(0)
  articlesProcessed Int             @default(0)
  articlesRejected  Int             @default(0)
  articlesApproved  Int             @default(0)
  errorMessage      String?
  durationMs        Int             @default(0)
  triggeredBy       String          @default("CRON") // "CRON" | "MANUAL_ADMIN"
  createdAt         DateTime        @default(now())

  @@index([createdAt])
  @@map("article_sync_logs")
}
