{
  "name": "zyba-v2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run db:generate:all && node --require ./eperm-patch.js node_modules/next/dist/bin/next build",
    "start": "next start -p 30000",
    "lint": "next lint",
    "postinstall": "pnpm run db:generate:all",
    "db:push:account": "prisma db push --schema=prisma/account/schema.prisma",
    "db:push:companion": "prisma db push --schema=prisma/companion/schema.prisma",
    "db:push:community": "prisma db push --schema=prisma/community/schema.prisma",
    "db:generate:all": "prisma generate --schema=prisma/account/schema.prisma && prisma generate --schema=prisma/companion/schema.prisma && prisma generate --schema=prisma/community/schema.prisma",
    "test:contrast": "node scripts/test-contrast.js",
    "test:scoring": "tsx tests/scoring.test.ts",
    "test:companion": "tsx tests/companion-quota.test.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.453.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@12.16.1"
}
